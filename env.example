# Google Sheets API Configuration
# Copy this file to .env and fill in your actual values

# Your Google Sheets API Key (from Google Cloud Console)
REACT_APP_GOOGLE_SHEETS_API_KEY=your_api_key_here

# Your Google Spreadsheet ID (from the spreadsheet URL)
REACT_APP_GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Firebase Configuration (if you have it)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Google Sheets API Configuration
# Copy this file to .env and fill in your actual values

# Your Google Sheets API Key (from Google Cloud Console)
REACT_APP_GOOGLE_SHEETS_API_KEY=your_api_key_here

# Your Google Spreadsheet ID (from the spreadsheet URL)
REACT_APP_GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Firebase Configuration (if you have it)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Resend API (for email notifications - required for email functionality)
REACT_APP_RESEND_API_KEY=your_resend_api_key

# Email Configuration
REACT_APP_FROM_EMAIL=enquiries@heronsquare.co.za
REACT_APP_ADMIN_EMAILS=kea.khoele@gmail.com,enquiries@heronsquare.co.za

